{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orange Dev",
  "mainBinaryName": "Orange",
  "version": "2.0.0-alpha.1",
  "identifier": "app.orange.converter.dev",
  "build": {
    "frontendDist": "../web-dist",
    "beforeBuildCommand": { "script": "node scripts/build-web.mjs", "cwd": ".." }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "copyright": "Orange",
    "shortDescription": "Drag a file, tap a key, convert it.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
