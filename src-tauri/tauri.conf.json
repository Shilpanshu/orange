{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orange",
  "mainBinaryName": "Orange",
  "version": "2.0.0",
  "identifier": "app.orange.converter",
  "build": {
    "frontendDist": "../web-dist",
    "beforeBuildCommand": {
      "script": "node scripts/build-web.mjs",
      "cwd": ".."
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://ofs.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost http://ofs.localhost blob: data: https://huggingface.co https://*.huggingface.co https://*.hf.co https://cdn.jsdelivr.net",
        "media-src": "'self' blob: http://ofs.localhost",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "script-src": "'self' 'wasm-unsafe-eval' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "copyright": "Orange",
    "shortDescription": "Drag a file, tap a key, convert it.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true,
    "publisher": "Shilpanshu",
    "homepage": "https://github.com/Shilpanshu/orange"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyRkU4NTRCNTg5OTQzNzEKUldSeFE1bFlTNFgrNGgrQ00wQTJPRUUxQkNkQU1yOE5UZ0tOREVBRXV5ZEFoM1RUNi9vOEN2ZHYK",
      "endpoints": [
        "https://shilpanshu.github.io/orange/update/latest.json",
        "https://github.com/Shilpanshu/orange/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
